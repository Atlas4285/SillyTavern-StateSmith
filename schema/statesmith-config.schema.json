{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/Atlas4285/SillyTavern-StateSmith/main/schema/statesmith-config.schema.json",
    "title": "StateSmith Configuration",
    "description": "A single StateSmith configuration profile.",
    "type": "object",
    "additionalProperties": false,
    "required": ["$schema", "name", "fields"],
    "properties": {
        "$schema": {
            "const": "https://raw.githubusercontent.com/Atlas4285/SillyTavern-StateSmith/main/schema/statesmith-config.schema.json"
        },
        "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
        },
        "description": {
            "type": "string",
            "maxLength": 1000
        },
        "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000,
            "description": "Prompt template injected with the current state. Supported placeholders: {{state}} and {{toolName}}."
        },
        "toolDescription": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "description": "Function tool description template. Supported placeholder: {{fields}}."
        },
        "fields": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/field"
            }
        }
    },
    "$defs": {
        "baseField": {
            "type": "object",
            "required": ["name", "label", "description", "type", "config"],
            "properties": {
                "name": {
                    "type": "string",
                    "pattern": "^[a-z一-鿿][a-z0-9_一-鿿]*$",
                    "maxLength": 64
                },
                "label": {
                    "type": "string",
                    "minLength": 0,
                    "maxLength": 100
                },
                "description": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                }
            }
        },
        "numericConfig": {
            "type": "object",
            "additionalProperties": false,
            "required": ["defaultValue", "min", "max"],
            "properties": {
                "defaultValue": {
                    "type": "number"
                },
                "min": {
                    "type": "number"
                },
                "max": {
                    "type": "number"
                }
            }
        },
        "textConfig": {
            "type": "object",
            "additionalProperties": false,
            "required": ["defaultValue", "maxLength"],
            "properties": {
                "defaultValue": {
                    "type": "string",
                    "maxLength": 10000
                },
                "maxLength": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10000
                }
            }
        },
        "toggleConfig": {
            "type": "object",
            "additionalProperties": false,
            "required": ["defaultValue"],
            "properties": {
                "defaultValue": {
                    "type": "boolean"
                }
            }
        },
        "choiceConfig": {
            "type": "object",
            "additionalProperties": false,
            "required": ["defaultValue", "options"],
            "properties": {
                "defaultValue": {
                    "type": "string",
                    "maxLength": 100
                },
                "options": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100
                    }
                }
            }
        },
        "field": {
            "oneOf": [
                {
                    "allOf": [
                        {
                            "$ref": "#/$defs/baseField"
                        },
                        {
                            "properties": {
                                "type": {
                                    "const": "number"
                                },
                                "config": {
                                    "$ref": "#/$defs/numericConfig"
                                }
                            }
                        }
                    ],
                    "unevaluatedProperties": false
                },
                {
                    "allOf": [
                        {
                            "$ref": "#/$defs/baseField"
                        },
                        {
                            "properties": {
                                "type": {
                                    "const": "progress"
                                },
                                "config": {
                                    "$ref": "#/$defs/numericConfig"
                                }
                            }
                        }
                    ],
                    "unevaluatedProperties": false
                },
                {
                    "allOf": [
                        {
                            "$ref": "#/$defs/baseField"
                        },
                        {
                            "properties": {
                                "type": {
                                    "const": "text"
                                },
                                "config": {
                                    "$ref": "#/$defs/textConfig"
                                }
                            }
                        }
                    ],
                    "unevaluatedProperties": false
                },
                {
                    "allOf": [
                        {
                            "$ref": "#/$defs/baseField"
                        },
                        {
                            "properties": {
                                "type": {
                                    "const": "toggle"
                                },
                                "config": {
                                    "$ref": "#/$defs/toggleConfig"
                                }
                            }
                        }
                    ],
                    "unevaluatedProperties": false
                },
                {
                    "allOf": [
                        {
                            "$ref": "#/$defs/baseField"
                        },
                        {
                            "properties": {
                                "type": {
                                    "const": "tag"
                                },
                                "config": {
                                    "$ref": "#/$defs/choiceConfig"
                                }
                            }
                        }
                    ],
                    "unevaluatedProperties": false
                },
                {
                    "allOf": [
                        {
                            "$ref": "#/$defs/baseField"
                        },
                        {
                            "properties": {
                                "type": {
                                    "const": "select"
                                },
                                "config": {
                                    "$ref": "#/$defs/choiceConfig"
                                }
                            }
                        }
                    ],
                    "unevaluatedProperties": false
                }
            ]
        }
    }
}
